<resources>
    <!-- Plain platform theme: black on white, no animations (e-ink friendly). -->
    <style name="Theme.Reader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorPrimary">@color/black</item>
        <item name="android:colorAccent">@color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Dialogs in night mode: light text on black. -->
    <style name="Theme.Reader.Dialog.Night" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/black</item>
        <item name="android:colorAccent">@color/night_text</item>
        <item name="android:textColorPrimary">@color/night_text</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
